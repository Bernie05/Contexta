# Optional. API keys and the Ollama URL can also be set in the app's Settings, which take priority.
# Copy to .env.local to set them here instead.

# Claude API (https://console.anthropic.com). Enables Claude models in the picker.
ANTHROPIC_API_KEY=

# Local Ollama server. Any chat model you have pulled shows up in the picker.
OLLAMA_URL=http://localhost:11434

# Leave empty to use the built-in local database (PGlite, stored in the data folder).
# Set to a Postgres server with pgvector to use that instead. Restart the app after changing it.
# DATABASE_URL=postgres://user:password@host:5432/contexta

# Where uploaded files, the local database and the embedding model cache are stored.
CONTEXTA_DATA_DIR=./data

# Local embedding model (transformers.js). Changing it requires re-indexing every document,
# and a model with a different size also needs EMBEDDING_DIMENSIONS changed in src/lib/schema.ts.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
