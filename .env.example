# Optional. API keys and the Ollama URL can also be set in the app's Settings, which take priority.
# Copy to .env.local to set them here instead.

# Claude API (https://console.anthropic.com). Enables Claude models in the picker.
ANTHROPIC_API_KEY=

# Local Ollama server. Any chat model you have pulled shows up in the picker.
OLLAMA_URL=http://localhost:11434

# Where PDFs, the SQLite database and the embedding model cache are stored.
CONTEXTA_DATA_DIR=./data

# Local embedding model (transformers.js). Changing it requires re-indexing every document.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
